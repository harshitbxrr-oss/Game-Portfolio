{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play in Chrome (dev server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Dev server"
    },
    {
      "name": "Play in Edge (dev server)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Dev server"
    },
    {
      "name": "Attach to Chrome (port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
