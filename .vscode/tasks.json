{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server",
      "type": "shell",
      "command": "node dev.mjs",
      "isBackground": true,
      "detail": "Serves the game at http://localhost:5173 and reloads the browser when you save a file in src/",
      "problemMatcher": {
        "owner": "dev-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting dev server",
          "endsPattern": "Dev server ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Build site",
      "type": "shell",
      "command": "node build.mjs",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Writes the self-contained index.html (this is the file you deploy)",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Check syntax",
      "type": "shell",
      "command": "node build.mjs --check",
      "detail": "Checks all JavaScript in src/ for syntax errors",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Build site (Python)",
      "type": "shell",
      "command": "python build.py",
      "detail": "Same result as Build site, for people who have Python but not Node. Use 'py build.py' on Windows if 'python' isn't found.",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
